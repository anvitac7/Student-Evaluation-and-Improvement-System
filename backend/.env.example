# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME=PLACER API
APP_ENV=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- Database ---
# Local dev (docker-compose):
MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=placer_db

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Auth cookie ---
# Set COOKIE_SECURE=true in production (requires HTTPS).
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Google OAuth ("Sign in with Google") ---
# Free. Get one at https://console.cloud.google.com/apis/credentials
# -> Create Credentials -> OAuth client ID -> Web application
# -> Authorized JavaScript origins: http://localhost:3000 (and your prod domain)
# No client secret needed for this flow.
GOOGLE_CLIENT_ID=

# --- Storage ---
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCAL_STORAGE_PATH=./storage
MAX_RESUME_SIZE_MB=5

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# --- OCR (PaddleOCR PP-OCRv4) ---
# Set to false to disable OCR fallback entirely
OCR_ENABLED=true
# OCR recognition language ('en', 'ch', etc.)
OCR_LANG=en
# Set to true if GPU/CUDA runtime is available
OCR_USE_GPU=false
# Use text angle direction classifier (rotates rotated text upright)
OCR_USE_ANGLE_CLS=true
# Minimum line detection confidence (0.0 to 1.0)
OCR_CONFIDENCE_THRESHOLD=0.5
# Minimum extracted character count below which OCR fallback triggers
OCR_TRIGGER_MIN_CHARS=50
# Minimum ratio of alphanumeric to total characters for text to be considered valid
OCR_MIN_ALPHANUMERIC_RATIO=0.5
# DPI resolution for rasterizing PDF pages to image before OCR (150 is optimal for speed/accuracy)
OCR_RENDER_DPI=150

# --- LLM (Phase A) ---
LLM_PRIMARY_PROVIDER=nvidia_nim
LLM_PRIMARY_MODEL=nvidia/nemotron-4-340b-instruct
LLM_PRIMARY_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_PRIMARY_API_KEY=

LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_MODEL=qwen/qwen3-8b
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=

LLM_USE_LOCAL_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

LLM_THINKING_MODE_NARRATIVE=true
LLM_THINKING_MODE_EXTRACTION=false
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DIM=768

KNOWLEDGE_STORE_BACKEND=mongodb_cosine

