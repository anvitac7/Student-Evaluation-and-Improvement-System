# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME=PLACER API
APP_ENV=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- Database ---
# Local dev (docker-compose):
MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=placer_db

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Auth cookie ---
# Set COOKIE_SECURE=true in production (requires HTTPS).
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Google OAuth ("Sign in with Google") ---
# Free. Get one at https://console.cloud.google.com/apis/credentials
# -> Create Credentials -> OAuth client ID -> Web application
# -> Authorized JavaScript origins: http://localhost:3000 (and your prod domain)
# No client secret needed for this flow.
GOOGLE_CLIENT_ID=

# --- Storage ---
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCAL_STORAGE_PATH=./storage
MAX_RESUME_SIZE_MB=5

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# --- OCR (PaddleOCR PP-OCRv4) ---
# Set to false to disable OCR fallback entirely
OCR_ENABLED=true
# OCR recognition language ('en', 'ch', etc.)
OCR_LANG=en
# Set to true if GPU/CUDA runtime is available
OCR_USE_GPU=false
# Use text angle direction classifier (rotates rotated text upright)
OCR_USE_ANGLE_CLS=true
# Minimum line detection confidence (0.0 to 1.0)
OCR_CONFIDENCE_THRESHOLD=0.5
# Minimum extracted character count below which OCR fallback triggers
OCR_TRIGGER_MIN_CHARS=50
# Minimum ratio of alphanumeric to total characters for text to be considered valid
OCR_MIN_ALPHANUMERIC_RATIO=0.5
# DPI resolution for rasterizing PDF pages to image before OCR (150 is optimal for speed/accuracy)
OCR_RENDER_DPI=150

# --- LLM (Phase A) ---
# Any OpenAI-compatible provider works. Provider is just a config value.
#
# Google Gemini (free tier: free input + output tokens, high RPM/RPD).
# Get a key at https://aistudio.google.com/apikey
# One key covers BOTH chat and embeddings — no local Ollama needed.
LLM_PRIMARY_PROVIDER=gemini
# Verify the exact model name still exists for your key before relying on it —
# Gemini retires model aliases, and a retired one fails with a 404 that looks
# like an auth problem. List what your key can reach:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
# Verify the exact model name still exists for your key before relying on it —
# Gemini retires model aliases aggressively, and a retired one fails with a
# 404 whose message reads like a naming nag rather than a real config error.
# List what your key can reach:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
# Measured on a free key: gemini-flash-lite-latest and gemini-3.5-flash-lite
# respond in ~1s; the gemini-3.x-flash tier returned 503 "high demand"
# repeatedly and 2.5-flash / 2.5-flash-lite are 404 for new users.
LLM_PRIMARY_MODEL=gemini-flash-lite-latest
LLM_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_PRIMARY_API_KEY=

# Free fallback. Get a key at https://openrouter.ai/keys
LLM_FALLBACK_PROVIDER=openrouter
LLM_FALLBACK_MODEL=qwen/qwen3-8b:free
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=

# True uses ONLY local Ollama — no fallback chain, no API key at all.
LLM_USE_LOCAL_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Note: LLM_THINKING_MODE_NARRATIVE / _EXTRACTION were REMOVED. They were
# never read by any code. Reasoning mode is chosen per call site via the
# `thinking=` kwarg and translated by the client into whatever key the active
# provider understands (enable_thinking for qwen, reasoning_effort for
# Gemini). Setting them here would only create a second, misleading source
# of truth.
# Gemini 3.x "thinking" models can take 30-60s on a cold call. 30s (the old
# default) reliably timed out; 90s gives headroom without stalling forever.
LLM_REQUEST_TIMEOUT_SECONDS=90
# Retries apply ONLY to transient failures (429, 5xx, connection, timeout).
# 4xx auth/validation errors are never retried — they won't fix themselves.
LLM_MAX_RETRIES=2
# Exponential backoff base: attempt N waits base * 2**N seconds.
LLM_RETRY_BACKOFF_SECONDS=1.5

# --- Embeddings (separate model, never the chat model) ---
# PROVIDER selects the request shape:
#   ollama -> POST {base}/api/embed   (local, no API key)
#   openai -> POST {base}/embeddings  (any OpenAI-compatible host)
# Matching "openai" with the Gemini base URL above lets one key serve both.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_API_KEY=
# Set to "ollama" + nomic-embed-text to go fully local instead:
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DIM=768

KNOWLEDGE_STORE_BACKEND=mongodb_cosine

